  "question": "FORECAST (not a replay): Will daily en.wikipedia.org pageviews for Artificial_intelligence grow by at least 15.00% on the full UTC day 2026-11-21 versus the full UTC day 2026-11-14? (Wikimedia Pageviews, all-access, user)",
  "choices": [
    "UP",
    "DOWN"
  ],
  "source": {
    "id": "wikimedia-pageviews-v1",
    "provider": "Wikimedia Analytics API",
    "project": "en.wikipedia.org",
    "article": "Artificial_intelligence",
    "access": "all-access",
    "agent": "user",
    "granularity": "daily",
    "timezone": "UTC",
    "endpoint_template": "https://wikimedia.org/api/rest_v1/metrics/pageviews/per-article/en.wikipedia.org/all-access/user/Artificial_intelligence/daily/{start}/{end}",
    "documentation": "https://doc.wikimedia.org/generated-data-platform/aqs/analytics-api/documentation/getting-started.html"
  },
  "observation": {
    "kind": "forecast",
    "replay": false,
    "baseline_date": "2026-11-14",
    "target_date": "2026-11-21",
