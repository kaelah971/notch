# Notch Trend Radar (S3A)
# No secrets are required for Wikimedia or Hacker News.
# A CoinGecko Demo key is optional; the public endpoint is used when empty.
RADAR_DATA_DIR=var/trend_radar
RADAR_USER_AGENT="NotchTrendRadar/0.1 (contact: ops@notch.example)"
COINGECKO_DEMO_API_KEY=
RADAR_OPERATOR=local-operator

# Notch deterministic oracle (S3B)
ORACLE_DATA_DIR=var/oracle
ORACLE_OPERATOR=local-operator

# Notch Intents funding adapter (S4)
# Tidepool is a community-operated 1Click-compatible testnet sandbox.
# Test tokens only; never send real assets.
TIDEPOOL_BASE_URL=https://www.usetidepool.tech
# Optional. Any non-empty value selects the lower provider fee tier.
TIDEPOOL_API_KEY=
INTENTS_DATA_DIR=var/intents
INTENTS_SOURCE_ASSET=nep141:usdt.tidepool-sandbox.testnet
NOTCH_ACCOUNT=notch-dev.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
MARKET_CONTRACT=market.notch-dev.testnet

# Phase 7C official NEAR Intents 1Click Mainnet discovery/dry quotes.
# Read-only only: no wet quote, deposit, signing, broadcast, or settlement path exists.
# Keep these server-side; never copy the JWT into web/.env or VITE_* variables.
NEAR_INTENTS_BASE_URL=https://1click.chaindefuser.com
NEAR_INTENTS_API_KEY=
# Live official Mainnet catalog asset; the server revalidates it against /v0/tokens.
NEAR_INTENTS_DESTINATION_ASSET=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
# Optional verified Mainnet account/refund defaults. The API still requires explicit user values for a quote.
NEAR_INTENTS_RECIPIENT=
NEAR_INTENTS_REFUND_TO=
NEAR_INTENTS_TIMEOUT_SECONDS=15
NEAR_INTENTS_MAX_RETRIES=2
NEAR_INTENTS_RATE_LIMIT_SECONDS=0.25
# Do not set these until separate Mainnet contract/collateral review is complete.
NOTCH_MAINNET_MARKET_CONTRACT=
NOTCH_MAINNET_COLLATERAL_TOKEN=

# Notch NEAR AI trend briefs (S5)
# Server-side only. Never expose the key to the frontend.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash
AI_BRIEFS_DATA_DIR=var/ai_briefs
RADAR_DB_PATH=var/trend_radar_live_final/radar.sqlite3
ORACLE_DB_PATH=var/oracle_live_final/oracle.sqlite3

# Notch frontend-ready web API (S6)
WEB_API_HOST=127.0.0.1
WEB_API_PORT=8000
WEB_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
WEB_API_MAX_BODY_BYTES=65536
WEB_API_RATE_LIMIT_PER_MINUTE=120
WEB_API_QUOTE_RATE_LIMIT_PER_MINUTE=10
WEB_API_ENTRY_RATE_LIMIT_PER_MINUTE=30
WEB_API_REQUEST_TIMEOUT_SECONDS=15
ORACLE_DB_PATHS=var/oracle_s2_5_short/oracle.sqlite3,var/oracle_live_final/oracle.sqlite3
COLLATERAL_TOKEN=usdc.tidepool-sandbox.testnet
# Pulse is read-only. Unset PULSE_START_BLOCK to begin coverage at first startup;
# set it only for an intentional bounded finalized-block backfill.
PULSE_DB_PATH=var/web_api/pulse.sqlite3
PULSE_START_BLOCK=
PULSE_MAX_BLOCKS_PER_REQUEST=25
WEB_API_SNAPSHOT_DB=var/web_api/snapshots.sqlite3
